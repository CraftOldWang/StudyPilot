MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
REDIS_PASSWORD=
RUSTFS_ACCESS_KEY=studypilot
RUSTFS_SECRET_KEY=
DEEPSEEK_API_KEY=
AI_DASHSCOPE_API_KEY=
